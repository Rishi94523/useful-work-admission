# Patent filing material lives OUTSIDE this repository, in a sibling directory.
# Git cannot stage what is not in the working tree, so no path rule is relied on.
# Content-level enforcement is scripts/check_publication.py, which blocks any
# staged path naming patent or identity documents wherever it appears.

# Local experiment notebooks and generated evidence are not publication artifacts
/local-research/
/docs/evaluation/
/docs/research/
docs/paper/figures/
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.out
docs/paper/*.pdf
docs/paper/*.fdb_latexmk
docs/paper/*.fls
